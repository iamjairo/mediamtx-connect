{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaMTX MCP",
  "version": "0.1.0",
  "identifier": "com.iamjairo.mediamtx-mcp-tray",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "MediaMTX MCP"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/mcp-server/**"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tray app for the MediaMTX MCP server.",
    "longDescription": "Menubar / tray app that supervises the MediaMTX MCP server (mcp-server/) as a child process. Start, stop, configure, and view logs without touching the terminal.",
    "publisher": "iamjairo",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/iamjairo/mediamtx-connect/releases/latest/download/mcp-tray-latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
